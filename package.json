{
  "name": "grapesjs-sidebar-tools",
  "version": "2.0.0",
  "description": "GrapesJS plugin: dockable tool panels — drag Styles, Settings, Layers, Blocks (and other plugins' views) into left, right and bottom zones around the canvas; side zones split in two; sizes and layout remembered.",
  "type": "module",
  "main": "./dist/grapesjs-sidebar-tools.umd.cjs",
  "module": "./dist/grapesjs-sidebar-tools.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/grapesjs-sidebar-tools.js",
      "require": "./dist/grapesjs-sidebar-tools.umd.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run check:package && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "grapesjs": ">=0.19.0 <1.0.0"
  },
  "devDependencies": {
    "grapesjs": "0.21.13",
    "jsdom": "^25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "grapesjs",
    "grapesjs-plugin",
    "dock",
    "docking",
    "panels",
    "tabs",
    "layout",
    "layers",
    "style-manager",
    "trait-manager",
    "sidebar"
  ],
  "author": "Alexander Shibisty",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shibisty/grapesjs-sidebar-tools.git"
  },
  "bugs": {
    "url": "https://github.com/shibisty/grapesjs-sidebar-tools/issues"
  },
  "homepage": "https://github.com/shibisty/grapesjs-sidebar-tools#readme"
}
